# Salin berkas ini menjadi ".env" (JANGAN di-commit), lalu isi kunci API dari https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opsional: model Gemini pilihan. Kosongkan untuk memakai bawaan (gemini-3.5-flash-lite).
GEMINI_MODEL=

# Opsional: asal frontend tambahan, pisahkan dengan koma. https://lailaafadhilah.github.io sudah otomatis diizinkan.
ALLOWED_ORIGINS=
